[Unit]
Description=Walkie.run (Next.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=walkie
Group=walkie
WorkingDirectory=/var/www/walkie
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npx next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/walkie /var/www/walkie-data

[Install]
WantedBy=multi-user.target
