# ───────── Core (required) ─────────
# SQLite for local dev. For production run `npm run db:use-postgres` and use a Postgres URL.
DATABASE_URL="file:./dev.db"
# Public base URL (no trailing slash). Used for OAuth redirects, emails, Stripe return URLs, CSRF origin check.
APP_URL="http://localhost:3000"

# First admin (used by `npm run admin:create`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ───────── Sign in with Google (optional) ─────────
# Console → APIs & Services → Credentials → OAuth client (Web). Redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ───────── Sign in with Apple (optional) ─────────
# Services ID + Key with "Sign in with Apple". Return URL: {APP_URL}/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=""        # Services ID, e.g. run.walkie.web
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""      # contents of the .p8 file; use \n for newlines

# ───────── Email (Resend) ─────────
# Without it, verification/reset emails are printed to the server console in development only.
RESEND_API_KEY=""
EMAIL_FROM="Walkie <hello@walkie.run>"

# ───────── Payments ─────────
# Stripe (web subscriptions). Webhook endpoint: {APP_URL}/api/webhooks/stripe
# Events: customer.subscription.created|updated|deleted, invoice.paid, invoice.payment_failed, charge.refunded
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PLUS_MONTHLY=""   # price_… (read by the seed script)
STRIPE_PRICE_PLUS_YEARLY=""
# RevenueCat (iOS/Android in-app purchases). Webhook: {APP_URL}/api/webhooks/revenuecat, Authorization header "Bearer <value>"
REVENUECAT_WEBHOOK_AUTH=""
REVENUECAT_SECRET_API_KEY=""   # v1 secret key, used by "Restore purchases"

# ───────── Maps (client-side, public) ─────────
# A MapLibre-compatible style URL with a *domain-restricted public* key, e.g.
# https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_PUBLIC_KEY
# Without it, routes render as a private SVG preview instead of a tile map.
NEXT_PUBLIC_MAP_STYLE_URL=""

# ───────── Analytics (optional) ─────────
# Events are always stored first-party (privacy-filtered). Set to also forward to PostHog.
POSTHOG_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"

# ───────── Push (optional) ─────────
# Firebase service account JSON (single line). iOS push works via an APNs key uploaded to Firebase.
FCM_SERVICE_ACCOUNT_JSON=""

# ───────── Ads (optional, off by default) ─────────
ADS_PROVIDER=""        # e.g. admob
ADS_PUBLISHER_ID=""

# ───────── Uploads ─────────
# Directory for uploaded images (defaults to ./public/uploads). Use a persistent volume in production.
UPLOAD_DIR=""

# ───────── Capacitor ─────────
CAP_SERVER_URL="https://walkie.run/app"

# ───────── Scheduled jobs & anti-abuse ─────────
# Bearer secret for POST /api/cron/referrals and POST /api/cron/leaderboard (schedule both hourly).
CRON_SECRET=""
# HMAC key for hashing IP addresses and signing install tokens (referral fraud signals). 32+ random bytes.
# Falls back to CRON_SECRET if unset. Rotating it invalidates existing install tokens / IP hashes (by design).
SIGNAL_SECRET=""

# Encrypts integration keys saved from Admin → Settings (AES-256-GCM). 32+ random characters, e.g. `openssl rand -base64 32`.
# Without it, keys can only be set here. Changing it makes keys saved in admin unreadable (re-enter them).
CONFIG_ENCRYPTION_KEY=""

# ───────── PayMongo (Philippines: GCash, Maya, cards, QR Ph) ─────────
# Dashboard → Developers → API keys (secret key, server-only) and Webhooks (signing secret).
# Webhook URL: https://walkie.run/api/webhooks/paymongo  · events: checkout_session.payment.paid, payment.refunded
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
PAYMONGO_PAYMENT_METHODS="gcash,paymaya,card,qrph"

# ───────── Maps (admin → Maps chooses provider order per platform; see docs/MAPS.md) ─────────
# Google Maps keys are visible to the browser/app by design — restrict each in Google Cloud Console
# (web key: HTTP referrer https://walkie.run/*; iOS key: bundle run.walkie.app; Android key: package + SHA-1).
GOOGLE_MAPS_WEB_KEY=""
GOOGLE_MAPS_IOS_KEY=""
GOOGLE_MAPS_ANDROID_KEY=""
# Apple MapKit JS (web + iOS web view only — Apple Maps is not offered on Android). Server-only .p8 key;
# the server signs 30-minute, origin-bound tokens at /api/maps/apple-token. Use \n for newlines.
APPLE_MAPKIT_TEAM_ID=""
APPLE_MAPKIT_KEY_ID=""
APPLE_MAPKIT_PRIVATE_KEY=""
# Open map (MapLibre) style. Default: https://tiles.openfreemap.org/styles/liberty
MAP_STYLE_URL=""
