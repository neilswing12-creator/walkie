{
  "name": "walkie-run",
  "version": "0.1.0",
  "private": true,
  "description": "Walkie.run \u2014 walk, run, collect pets, build your cozy pet shop.",
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && next dev",
    "build": "node scripts/copy-vendor.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs && node scripts/e2e-referrals.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:use-postgres": "node scripts/use-postgres.mjs",
    "admin:create": "tsx scripts/create-admin.ts",
    "cap:sync": "cap sync",
    "cap:android": "cap open android"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/geolocation": "7.1.5",
    "@capacitor/google-maps": "^7.2.2",
    "@capacitor/ios": "^7.6.10",
    "@capacitor/push-notifications": "7.0.3",
    "@capgo/capacitor-health": "7.2.15",
    "@fontsource-variable/fredoka": "^5.2.5",
    "@fontsource-variable/nunito": "^5.2.6",
    "@prisma/client": "6.19.2",
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "maplibre-gl": "^6.16.0",
    "next": "^15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "three": "0.170.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.170.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
